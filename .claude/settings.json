{
  "permissions": {
    "deny": [
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(.github/workflows/ci.yml)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/hooks/**)",
      "Read(.env)",
      "Read(**/secrets/**)",
      "Read(**/.aws/**)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(DROP TABLE*)",
      "Bash(TRUNCATE*)",
      "Bash(Remove-Item*-Recurse*)"
    ],
    "allow": [
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(pytest*)",
      "Bash(mypy*)",
      "Bash(bandit*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(echo*)",
      "Bash(printf*)",
      "Bash(ls*)",
      "Bash(wc*)",
      "Bash(cat*)",
      "Bash(test*)",
      "Bash(python *)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(pip install*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-rm.ps1"
            ]
          }
        ]
      }
    ]
  }
}
